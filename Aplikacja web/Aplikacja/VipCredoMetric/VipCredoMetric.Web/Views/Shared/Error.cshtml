@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<h1 class="text-danger">Błąd.</h1>
<h2 class="text-danger">Podczas przetwarzania żądania wystąpił błąd.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identyfikator żądania:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Tryb deweloperski</h3>
<p>
    Przełączenie na środowisko <strong>Development</strong> spowoduje wyświetlenie bardziej szczegółowych informacji o błędzie, który wystąpił.
</p>
<p>
    <strong>Środowisko Development nie powinno być włączone dla aplikacji wdrożonych produkcyjnie.</strong>
    Może to spowodować wyświetlenie użytkownikom końcowym poufnych informacji z wyjątków.
    Aby debugować lokalnie, włącz środowisko <strong>Development</strong>, ustawiając zmienną środowiskową <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    i ponownie uruchamiając aplikację.
</p>
