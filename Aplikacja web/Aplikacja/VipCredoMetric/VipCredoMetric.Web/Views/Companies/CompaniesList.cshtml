@model IEnumerable<VipCredoMetric.Web.Models.Companies.CompanyListItemViewModel>

@{
    ViewData["Title"] = "Firmy";
}

<h1>Firmy</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.LegalForm)</th>
            <th>@Html.DisplayNameFor(model => model.Nip)</th>
            <th>@Html.DisplayNameFor(model => model.Regon)</th>
            <th>@Html.DisplayNameFor(model => model.BusinessStartDate)</th>
            <th>@Html.DisplayNameFor(model => model.PkdCode)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.LegalForm)</td>
                <td>@Html.DisplayFor(modelItem => item.Nip)</td>
                <td>@Html.DisplayFor(modelItem => item.Regon)</td>
                <td>@Html.DisplayFor(modelItem => item.BusinessStartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.PkdCode)</td>
            </tr>
        }
    </tbody>
</table>
