@using VipCredoMetric.Web.Models.Common
@using VipCredoMetric.Web.Models.Companies
@model PagedListViewModel<CompanyListItemViewModel>

@{
    ViewData["Title"] = "Firmy";
}

<h1>Firmy</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Name)</th>
            <th>@Html.DisplayNameFor(model => model.First().LegalForm)</th>
            <th>@Html.DisplayNameFor(model => model.First().Nip)</th>
            <th>@Html.DisplayNameFor(model => model.First().Regon)</th>
            <th>@Html.DisplayNameFor(model => model.First().BusinessStartDate)</th>
            <th>@Html.DisplayNameFor(model => model.First().PkdCode)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.LegalForm)</td>
                <td>@Html.DisplayFor(modelItem => item.Nip)</td>
                <td>@Html.DisplayFor(modelItem => item.Regon)</td>
                <td>@Html.DisplayFor(modelItem => item.BusinessStartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.PkdCode)</td>
            </tr>
        }
    </tbody>
</table>

@{
    ViewData["PaginationController"] = "Company";
    ViewData["PaginationAction"] = "GetCompaniesList";
}
<partial name="_Pagination" model="Model.Metadata" />

