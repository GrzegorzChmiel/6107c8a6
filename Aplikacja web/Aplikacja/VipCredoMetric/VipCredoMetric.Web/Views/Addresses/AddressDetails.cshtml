@model VipCredoMetric.Web.Models.Addresses.AddressFormViewModel

@{
    ViewData["Title"] = "Address Details";
}

<h1>Address Details</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Country)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Country)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.City)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PostalCode)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.PostalCode)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Street)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Street)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HouseNumber)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.HouseNumber)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ApartmentNumber)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.ApartmentNumber)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsPrimary)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.IsPrimary)</dd>
</dl>

<button type="button" class="btn btn-secondary" onclick="history.back()">Back</button>
