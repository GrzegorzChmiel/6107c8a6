@using VipCredoMetric.Web.Models.Common
@using VipCredoMetric.Web.Models.Persons
@model PagedListViewModel<PersonListItemViewModel>

@{
    ViewData["Title"] = "Osoby";
}

<h1>Osoby</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.First().LastName)</th>
            <th>@Html.DisplayNameFor(model => model.First().BirthDate)</th>
            <th>@Html.DisplayNameFor(model => model.First().PeselNumber)</th>
            <th>@Html.DisplayNameFor(model => model.First().IdentityCardNumber)</th>
            <th />
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>
                <td>@Html.DisplayFor(modelItem => item.PeselNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.IdentityCardNumber)</td>
                <td>
                   <a class="btn btn-sm btn-primary" asp-controller="Person" asp-action="GetPersonDetails" asp-route-id="@item.Id">Szczegóły</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    ViewData["PaginationController"] = "Person";
    ViewData["PaginationAction"] = "GetPersonsList";
}
<partial name="_Pagination" model="Model.Metadata" />

