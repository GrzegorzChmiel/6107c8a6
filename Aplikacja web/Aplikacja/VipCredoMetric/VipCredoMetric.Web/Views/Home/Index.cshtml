@{
    ViewData["Title"] = "Strona główna";
}

<div style="position: relative; margin: -1rem -1.5rem 0; height: calc(100vh - 56px - 70px); min-height: 400px; overflow: hidden;">
    <img src="~/images/credit-score-hero.jpg"
         alt="Ocena zdolności kredytowej firm"
         style="width: 100%; height: 100%; object-fit: cover;" />
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.35); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: white; padding: 1rem;">
        <h1 class="display-4">Witaj</h1>
        <p class="lead">VipCredoMetric &ndash; profesjonalna ocena zdolności kredytowej firm.</p>
    </div>
</div>
